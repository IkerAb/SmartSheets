APP_NAME=SmartSheets Sales Forecasting API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sales_analytics
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=sales_pass

CACHE_TTL_SECONDS=3600
MAX_UPLOAD_MB=50
MIN_ROWS_FORECAST=30
DEFAULT_HORIZON=30
DEFAULT_CONFIDENCE=0.90
ZSCORE_THRESHOLD=2.5
